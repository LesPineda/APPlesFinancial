# Puerto de desarrollo local
PORT=3000

# Clave secreta para autorizar llamadas a /api (x-api-key)
API_SECRET_KEY="apples_fin_sec_key_2026_x89"

# Cadena de conexión Supabase Transaction Pooler (puerto 6543 con ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Cadena de conexión directa Supabase Direct (puerto 5432 para migraciones Prisma)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Parámetros del proyecto Supabase
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR_SUPABASE_PUBLISHABLE_KEY]"
SUPABASE_SECRET_KEY="[YOUR_SUPABASE_SECRET_KEY]"
SUPABASE_JWKS_URL="https://[PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json"
