datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  DEBITO
  CREDITO
  EFECTIVO
  SERVICIO
}

enum TransactionType {
  INGRESO
  GASTO
}

model Account {
  id            String        @id @default(uuid())
  nombre        String        @unique
  tipo          AccountType
  saldo_actual  Decimal
  transactions  Transaction[]
  debts         Debt[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("cuentas")
}

model Transaction {
  id                String          @id @default(uuid())
  cuenta_id         String
  cuenta            Account         @relation(fields: [cuenta_id], references: [id], onDelete: Cascade)
  tipo              TransactionType
  monto             Decimal
  fecha_transaccion DateTime
  descripcion       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("transacciones")
}

model Debt {
  id                 String   @id @default(uuid())
  cuenta_id          String
  cuenta             Account  @relation(fields: [cuenta_id], references: [id], onDelete: Cascade)
  saldo_total        Decimal
  tasa_interes_ea    Decimal
  pago_minimo        Decimal
  fecha_corte        DateTime
  fecha_limite_pago  DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("deudas")
}
